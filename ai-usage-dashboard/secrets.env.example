# Variable names only -- no values. Save as secrets.env in the add-on
# config directory on the Home Assistant host
# (addon_configs/ai_usage_dashboard/secrets.env, via the File editor,
# Samba, or SSH add-on; in-container path /config/secrets.env) and
# reference the names from the add-on Configuration tab. Never commit a
# filled-in copy. Permissions should be owner-only (0600).
OPENAI_API_KEY_PRIMARY=
OPENAI_API_KEY_SECONDARY=
ANTHROPIC_API_KEY=
KIMI_API_KEY=
DEEPSEEK_API_KEY=
# Referenced (config-only) by opencode_go accounts; no quota endpoint is
# polled -- subscription usage lives at https://opencode.ai/auth.
OPENCODE_GO_TOKEN=
# Referenced (config-only) by muse_code accounts; an API key is
# pay-as-you-go access, not proof of subscription quota.
MUSE_CODE_TOKEN=
# Exposed only inside the `bl usage coding-plan` child process environment
# (opt-in Alibaba CLI mode). Opt in only if automated polling is allowed
# for your plan: Coding Plan keys are meant for interactive coding tools.
ALIBABA_CODING_PLAN_COOKIE=
ALIBABA_CODING_PLAN_API_KEY=
MQTT_PASSWORD=
